# Vibe Launcher – Build-Umgebung (Vorlage). Werte NICHT committen.
# Die Variablen werden beim Kompilieren (cargo/tauri build) eingebettet; im Release kommen sie aus
# den GitHub-Secrets. Lokal z. B. in PowerShell setzen:  $env:CURSEFORGE_API_KEY = "..."

# CurseForge-API-Key (console.curseforge.com). Leer = CurseForge deaktiviert.
CURSEFORGE_API_KEY=

# Application (client) ID der Azure-App-Registrierung für den Microsoft-Login. Leer = kein Login möglich.
VIBE_MSA_CLIENT_ID=

# Nur für signierte Release-Builds (Updater): Inhalt ODER Pfad der privaten Schlüsseldatei + Passwort.
# Die Schlüsseldatei selbst gehört nie ins Repository.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# --- Laufzeit (nur Entwicklung/Tests) ---
# Eigener Datenordner statt %APPDATA%\VibeLauncher (Testmodus, keine Single-Instance-Sperre)
# VIBE_LAUNCHER_HOME=
# Nur Debug-Builds: Spielstart mit Offline-Profil, wenn kein Account aktiv ist
# VIBE_DEV_OFFLINE_ACCOUNT=
# Log-Filter (tracing EnvFilter)
# VIBE_LOG=info
