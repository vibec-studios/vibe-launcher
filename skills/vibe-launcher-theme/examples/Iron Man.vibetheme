{
  "format": "vibe-launcher-theme",
  "version": 2,
  "name": "Iron Man",
  "author": "Vibe Launcher",
  "description": "Rot und Gold, kantige leuchtende Knöpfe, HUD-Linien und ein animierter Arc Reactor mit Jarvis-Begrüßung auf der Startseite.",
  "values": {
    "theme": "nether",
    "accent": "#ffb627",
    "tone": "dark",
    "radius": "square",
    "radius_px": 0,
    "contrast": "normal",
    "cards": "outlined",
    "headings": "default",
    "font": "inter_tight",
    "font_scale": 100,
    "status": {
      "ok": "#5be3c0",
      "warn": "#ffd166",
      "danger": "#ff4d4d"
    },
    "glass": 0,
    "sidebar_style": "solid",
    "background": {
      "kind": "gradient",
      "gradient": "custom",
      "animated": "aurora",
      "color": "#160506",
      "gradient_from": "#1c0405",
      "gradient_to": "#2e0d07",
      "gradient_angle": 160,
      "dim": 10,
      "blur": 0
    }
  },
  "palette": {
    "frame": "#0d0304",
    "canvas": "#160506",
    "surface": "#220a0b",
    "surface2": "#2d0f10",
    "surface3": "#3a1415",
    "overlay": "#1c0708",
    "border": "#4a1d14",
    "border2": "#6b3016",
    "field": "#1e0809",
    "text": "#fff1e0",
    "muted": "#e0b9a0",
    "dim": "#b8907a",
    "on_accent": "#1d0b00"
  },
  "css": "@keyframes reactor-spin {\n  to { transform: rotate(360deg); }\n}\n@keyframes reactor-pulse {\n  0%, 100% { opacity: .78; }\n  50% { opacity: 1; }\n}\n@keyframes hud-scan {\n  from { transform: translateY(-100%); }\n  to { transform: translateY(100%); }\n}\n\n[data-part=\"button-primary\"], [data-part=\"button-accent\"] {\n  position: relative;\n  border-radius: 0;\n  border-color: transparent;\n  background-color: #f3a81f;\n  background-image: linear-gradient(180deg, #ffd66e 0%, #f3a81f 55%, #d9860e 100%);\n  color: #1d0b00;\n  text-transform: uppercase;\n  letter-spacing: .08em;\n  font-weight: 800;\n  box-shadow: inset 0 0 0 1px #ffe39a, 0 0 14px rgb(255 176 32 / .45), 0 0 2px rgb(255 214 110 / .9);\n}\n[data-part=\"button-primary\"]:hover, [data-part=\"button-accent\"]:hover {\n  filter: brightness(1.06);\n  box-shadow: inset 0 0 0 1px #fff0c2, 0 0 24px rgb(255 176 32 / .7), 0 0 2px #ffe39a;\n}\n[data-part=\"button-primary\"]::before, [data-part=\"button-primary\"]::after {\n  content: \"\";\n  position: absolute;\n  width: 7px;\n  height: 7px;\n  border: 2px solid #ffd66e;\n}\n[data-part=\"button-primary\"]::before { left: -4px; top: -4px; border-right: 0; border-bottom: 0; }\n[data-part=\"button-primary\"]::after { right: -4px; bottom: -4px; border-left: 0; border-top: 0; }\n\n[data-part=\"button-ghost\"], [data-part=\"button-outline\"] {\n  border-radius: 0;\n  background-color: rgb(255 182 39 / .06);\n  box-shadow: inset 0 0 0 1px rgb(255 182 39 / .35);\n  text-transform: uppercase;\n  letter-spacing: .06em;\n}\n[data-part=\"button-ghost\"]:hover, [data-part=\"button-outline\"]:hover {\n  background-color: rgb(255 182 39 / .14);\n  box-shadow: inset 0 0 0 1px rgb(255 214 110 / .7), 0 0 12px rgb(255 176 32 / .3);\n}\n[data-part=\"icon-button\"] { border-radius: 0; }\n\n[data-part=\"nav-item\"] { border-radius: 0; }\n[data-part=\"nav-item\"][aria-current=\"page\"] {\n  color: #ffd66e;\n  background-color: rgb(255 182 39 / .1);\n  box-shadow: inset 2px 0 0 #ffb627, 0 0 14px rgb(255 182 39 / .22);\n}\n[data-part=\"sidebar\"] { box-shadow: inset -1px 0 0 rgb(255 110 60 / .18); }\n[data-part=\"header\"] {\n  background-image: linear-gradient(90deg, transparent, rgb(255 182 39 / .35), transparent);\n  background-size: 100% 1px;\n  background-repeat: no-repeat;\n  background-position: bottom;\n}\n\n[data-part=\"card\"], [data-part=\"instance-tile\"] { border-radius: 0; }\n[data-part=\"card\"] { box-shadow: inset 0 0 0 1px rgb(255 110 60 / .22); }\n[data-part=\"home-hero\"] { box-shadow: inset 0 2px 0 #ffb627, inset 0 0 0 1px rgb(255 110 60 / .25), 0 0 30px rgb(200 30 30 / .18); }\n[data-part=\"instance-tile\"]:hover { box-shadow: inset 0 0 0 1px rgb(255 182 39 / .45), 0 0 18px rgb(255 120 40 / .2); }\n[data-part=\"input\"] { border-radius: 0; }\n[data-part=\"input\"]:focus { box-shadow: 0 0 0 1px #ffb627, 0 0 12px rgb(255 182 39 / .35); }\n[data-part=\"tab\"][aria-selected=\"true\"] { box-shadow: inset 0 -2px 0 #ffb627, 0 6px 12px -8px rgb(255 182 39 / .8); }\n[data-part=\"badge\"], [data-part=\"chip\"] { border-radius: 0; }\n[data-part=\"progress\"] { border-radius: 0; background-color: rgb(255 110 60 / .15); }\n[data-part=\"progress-bar\"] { background-image: linear-gradient(90deg, #c81d25, #ffb627); box-shadow: 0 0 10px rgb(255 160 40 / .6); }\n\n[data-slot=\"background\"] {\n  background-image:\n    radial-gradient(60% 50% at 85% 0%, rgb(255 140 40 / .08), transparent 70%),\n    linear-gradient(rgb(255 110 60 / .045) 1px, transparent 1px),\n    linear-gradient(90deg, rgb(255 110 60 / .045) 1px, transparent 1px);\n  background-size: 100% 100%, 36px 36px, 36px 36px;\n}\n\n.jarvis {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: 24px;\n  padding: 18px 24px;\n  overflow: hidden;\n  background: linear-gradient(90deg, rgb(127 232 255 / .09), rgb(127 232 255 / .02) 55%, transparent);\n  box-shadow: inset 0 0 0 1px rgb(127 232 255 / .2), inset 3px 0 0 #7fe8ff;\n}\n.jarvis::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(180deg, transparent, rgb(127 232 255 / .07), transparent);\n  animation: hud-scan 5s linear infinite;\n}\n.reactor { position: relative; width: 116px; height: 116px; flex: none; }\n.reactor svg { position: absolute; inset: 0; width: 100%; height: 100%; }\n.outer { animation: reactor-spin 16s linear infinite; }\n.inner { animation: reactor-spin 9s linear infinite reverse; }\n.core { animation: reactor-pulse 2.8s ease-in-out infinite; filter: drop-shadow(0 0 12px #4fd8ff); }\n.hud { display: flex; flex-direction: column; gap: 6px; min-width: 0; }\n.tag { font: 700 11px/1 ui-monospace, Consolas, monospace; letter-spacing: .32em; color: #7fe8ff; }\n.dot { display: inline-block; width: 7px; height: 7px; margin-right: 8px; background: #5bffb0; box-shadow: 0 0 8px #5bffb0; animation: reactor-pulse 1.6s ease-in-out infinite; }\n.line { font-size: 27px; font-weight: 800; line-height: 1.15; letter-spacing: -.01em; color: #fff4e0; text-shadow: 0 0 22px rgb(255 182 39 / .35); }\n.meta { font: 500 12px/1.4 ui-monospace, Consolas, monospace; letter-spacing: .04em; color: #e6c2a6; }\n.mini { display: flex; justify-content: center; padding: 6px 0 10px; }\n.mini svg { width: 34px; height: 34px; filter: drop-shadow(0 0 6px #4fd8ff); animation: reactor-pulse 2.8s ease-in-out infinite; }\n.bracket { width: 150px; height: 150px; margin: 10px; }\n",
  "slots": {
    "background": "<div class=\"hud-grid\"></div>",
    "home-hero": "<div class=\"jarvis\"><div class=\"reactor\"><svg class=\"outer\" viewBox=\"0 0 120 120\"><circle cx=\"60\" cy=\"60\" r=\"56\" fill=\"none\" stroke=\"#7fe8ff\" stroke-width=\"1.5\" stroke-dasharray=\"10 6\" opacity=\".7\"/><circle cx=\"60\" cy=\"60\" r=\"50\" fill=\"none\" stroke=\"#ffb627\" stroke-width=\"1\" stroke-dasharray=\"2 8\" opacity=\".8\"/></svg><svg class=\"inner\" viewBox=\"0 0 120 120\"><circle cx=\"60\" cy=\"60\" r=\"44\" fill=\"none\" stroke=\"#9ff3ff\" stroke-width=\"3\" stroke-dasharray=\"40 14\" opacity=\".55\"/></svg><svg class=\"core\" viewBox=\"0 0 120 120\"><defs><radialGradient id=\"glow\"><stop offset=\"0\" stop-color=\"#ffffff\"/><stop offset=\".35\" stop-color=\"#c9f8ff\"/><stop offset=\".7\" stop-color=\"#3ec8ff\" stop-opacity=\".55\"/><stop offset=\"1\" stop-color=\"#1fb6ff\" stop-opacity=\"0\"/></radialGradient></defs><circle cx=\"60\" cy=\"60\" r=\"38\" fill=\"url(#glow)\"/><g opacity=\".85\"><rect x=\"57\" y=\"14\" width=\"6\" height=\"14\" fill=\"#bff6ff\" transform=\"rotate(0 60 60)\"/><rect x=\"57\" y=\"14\" width=\"6\" height=\"14\" fill=\"#bff6ff\" transform=\"rotate(36 60 60)\"/><rect x=\"57\" y=\"14\" width=\"6\" height=\"14\" fill=\"#bff6ff\" transform=\"rotate(72 60 60)\"/><rect x=\"57\" y=\"14\" width=\"6\" height=\"14\" fill=\"#bff6ff\" transform=\"rotate(108 60 60)\"/><rect x=\"57\" y=\"14\" width=\"6\" height=\"14\" fill=\"#bff6ff\" transform=\"rotate(144 60 60)\"/><rect x=\"57\" y=\"14\" width=\"6\" height=\"14\" fill=\"#bff6ff\" transform=\"rotate(180 60 60)\"/><rect x=\"57\" y=\"14\" width=\"6\" height=\"14\" fill=\"#bff6ff\" transform=\"rotate(216 60 60)\"/><rect x=\"57\" y=\"14\" width=\"6\" height=\"14\" fill=\"#bff6ff\" transform=\"rotate(252 60 60)\"/><rect x=\"57\" y=\"14\" width=\"6\" height=\"14\" fill=\"#bff6ff\" transform=\"rotate(288 60 60)\"/><rect x=\"57\" y=\"14\" width=\"6\" height=\"14\" fill=\"#bff6ff\" transform=\"rotate(324 60 60)\"/></g><circle cx=\"60\" cy=\"60\" r=\"13\" fill=\"#ffffff\" stroke=\"#9ff3ff\" stroke-width=\"3\"/></svg></div><div class=\"hud\"><div class=\"tag\"><span class=\"dot\"></span>J.A.R.V.I.S. · ONLINE</div><div class=\"line\">{{greeting}}, {{player}}.</div><div class=\"meta\">{{date}} · {{time}} · {{instances}} Instanzen · zuletzt: {{last_played}}</div></div></div>",
    "sidebar-top": "<div class=\"mini\"><svg viewBox=\"0 0 40 40\"><circle cx=\"20\" cy=\"20\" r=\"17\" fill=\"none\" stroke=\"#7fe8ff\" stroke-width=\"2\" stroke-dasharray=\"5 3\"/><circle cx=\"20\" cy=\"20\" r=\"9\" fill=\"#d9fbff\" stroke=\"#3ec8ff\" stroke-width=\"3\"/></svg></div>",
    "corner-tr": "<svg class=\"bracket\" viewBox=\"0 0 150 150\"><path d=\"M20 3 H147 V130\" fill=\"none\" stroke=\"#ffb627\" stroke-width=\"2\" opacity=\".55\"/><path d=\"M60 14 H136 V90\" fill=\"none\" stroke=\"#7fe8ff\" stroke-width=\"1\" stroke-dasharray=\"3 5\" opacity=\".5\"/><circle cx=\"147\" cy=\"3\" r=\"3\" fill=\"#ffb627\"/></svg>"
  }
}
